    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/database/seed.ts",
    "simuler:balance": "tsx scripts/simuler-balance.mts",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "mesurer:maya": "vitest run tests/unit/server/utils/mayaCorpus.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.2",
    "@nuxt/ui": "^3",
    "@pinia/nuxt": "^0.9",
    "@sentry/vue": "^10.45.0",
    "@supabase/supabase-js": "^2.47",
    "@vercel/analytics": "^2.0.1",
    "@vueuse/core": "^12",
    "@vueuse/motion": "^3.0",
    "@vueuse/nuxt": "^12",
    "browser-image-compression": "^2.0.2",
    "drizzle-orm": "^0.38",
    "echarts": "^5.6",
    "exceljs": "^4.4.0",
    "html2pdf.js": "^0.14.0",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.469",
    "nuxt": "~3.21.7",
    "pinia": "^2.3",
    "postgres": "^3.4",
    "posthog-js": "^1.380.0",
    "qrcode": "^1.5.4",
    "resend": "^6.12.4",
    "stripe": "^17",
    "vue": "^3.5",
    "vue-router": "^4",
    "web-push": "^3.6.7",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1",
    "@nuxt/eslint": "^0.7",
    "@nuxt/test-utils": "^3",
    "@nuxtjs/supabase": "^1",
    "@playwright/test": "^1.49",
    "@sentry/vite-plugin": "^5.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/test-utils": "^2",
    "drizzle-kit": "^0.30",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "happy-dom": "^16",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "sharp": "^0.34.5",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^3",
    "vue-tsc": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
