{
  "name": "apigo",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de gestion apicole tout-en-un — Du rucher à la comptabilité",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
