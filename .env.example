# ═══════════════════════════════════════════════════════════════════════════
# APIGO — fichier de référence des variables d'environnement
#
# Le README dit `cp .env.example .env` depuis toujours, mais le fichier avait
# disparu de l'arbre. Le voici reconstitué depuis `runtimeConfig` de
# nuxt.config.ts et les `process.env` réellement lus dans le code.
#
# ⚠️ AUCUNE VALEUR RÉELLE ICI, JAMAIS. Ce dépôt est PUBLIC, et ce fichier est
# le seul `.env*` versionné (`.gitignore` : règle `.env*` + exception
# `!.env.example`). Une clé collée ici part sur GitHub à la seconde d'après.
#
# ⚠️ LE `.env` DE CE DÉPÔT POINTE LA PRODUCTION — la base des clients qui
# paient. Il n'existe pas de bac à sable. `npm run db:push` et `db:seed`
# passent par `scripts/garde-base.ts` qui refuse une cible de production, mais
# rien ne protège une requête écrite à la main.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Base de données ───────────────────────────────────────────────────────
# Chaîne postgres du pooler Supabase. C'est ELLE que `server/utils/db.ts` lit,
# directement, sans garde-fou d'environnement.
DATABASE_URL=
# Taille du pool. Vide = valeur par défaut du code.
DB_POOL_MAX=

# ─── Supabase ──────────────────────────────────────────────────────────────
# Lues par le module @nuxtjs/supabase. Sans elles, le module avertit au build
# et TOUTES les pages prérendues échouent en silence (`failOnError: false`) —
# le build reste vert et le site part en SSR intégral sans que rien le signale.
SUPABASE_URL=
SUPABASE_KEY=
# Clé service_role : contourne la RLS. À ne jamais exposer côté client.
SUPABASE_SERVICE_KEY=
NUXT_SUPABASE_SERVICE_KEY=

# ─── Application ───────────────────────────────────────────────────────────
NUXT_PUBLIC_BASE_URL=
NUXT_PUBLIC_APP_VERSION=

# ─── Stripe ────────────────────────────────────────────────────────────────
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_PRICE_STARTER=
NUXT_STRIPE_PRICE_PRO=
NUXT_STRIPE_PRICE_EXPERT=
NUXT_STRIPE_PRICE_STARTER_ANNUAL=
NUXT_STRIPE_PRICE_PRO_ANNUAL=
NUXT_STRIPE_PRICE_EXPERT_ANNUAL=
NUXT_STRIPE_TOS_REQUIRED=
# Prix affichés (centimes). Doivent rester alignés sur les tarifs Stripe
# ci-dessus : un écart se voit directement sur la page tarifs.
NUXT_PRICE_STARTER_MONTHLY=
NUXT_PRICE_STARTER_YEARLY=
NUXT_PRICE_PRO_MONTHLY=
NUXT_PRICE_PRO_YEARLY=
NUXT_PRICE_EXPERT_MONTHLY=
NUXT_PRICE_EXPERT_YEARLY=

# ─── E-mails ───────────────────────────────────────────────────────────────
NUXT_BREVO_API_KEY=
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=
NUXT_EMAIL_REPLY_TO=

# ─── Notifications push (VAPID) ────────────────────────────────────────────
NUXT_VAPID_PRIVATE_KEY=
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_SUBJECT=

# ─── Tâches planifiées ─────────────────────────────────────────────────────
# Secret exigé par `assertCronAuth`. Vercel envoie `CRON_SECRET` ; le code
# accepte les deux noms.
NUXT_CRON_SECRET=
CRON_SECRET=

# ─── Administration ────────────────────────────────────────────────────────
# Liste d'e-mails séparés par des virgules. C'est la seule barrière d'accès
# à /admin : une adresse ajoutée ici obtient tous les droits.
NUXT_ADMIN_EMAILS=

# ─── Limitation de débit (Upstash Redis) ───────────────────────────────────
# Vides, le compteur retombe en mémoire du processus : suffisant en local,
# inopérant en serverless où chaque instance a son propre compteur.
NUXT_UPSTASH_REDIS_REST_URL=
NUXT_UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Anti-robot ────────────────────────────────────────────────────────────
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Rapprochement bancaire (GoCardless) ───────────────────────────────────
NUXT_GOCARDLESS_SECRET_ID=
NUXT_GOCARDLESS_SECRET_KEY=

# ─── Observabilité ─────────────────────────────────────────────────────────
NUXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=
NUXT_POSTHOG_PERSONAL_API_KEY=
NUXT_POSTHOG_PROJECT_ID=

# ═══════════════════════════════════════════════════════════════════════════
# TESTS — variables lues UNIQUEMENT par l'outillage, jamais par l'application
# ═══════════════════════════════════════════════════════════════════════════

# Bancs d'écriture (`npm run test:integration`). Ils créent un compte
# éphémère, travaillent dedans, et le suppriment. Sans cette variable à `oui`,
# ils sont SAUTÉS dès que la cible n'est pas une base locale — un banc sauté
# se voit, un banc rouge se discute.
APIGO_AUTORISE_ECRITURE_BASE=

# Bancs de bout en bout authentifiés. Compte réel : ce qu'ils écrivent est
# écrit pour de bon. Les specs ne créent que des objets préfixés « E2E — » et
# les suppriment après chaque cas.
E2E_EMAIL=
E2E_PASSWORD=

# Cible des bancs Playwright. Vide → serveur de dev local démarré et neutralisé
# par playwright.config.ts. Renseignée avec une URL de preview Vercel, les mêmes
# specs s'exécutent contre le déploiement réel — utile, mais ce preview tape la
# base de PRODUCTION.
PLAYWRIGHT_BASE_URL=

# Chemin d'un Chromium déjà installé, quand `playwright install` est
# impossible. Ne s'applique qu'au projet `chromium` : le projet `mobile` vise
# WebKit et planterait avec un binaire Chromium.
PLAYWRIGHT_CHROMIUM_PATH=
